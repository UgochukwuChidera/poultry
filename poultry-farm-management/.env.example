# Preferred runtime configuration: Supabase API access.
# Server components/actions use the service role key when present; keep it server-only.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Optional server-only fallback for Drizzle, local scripts, and migration tooling.
# Runtime reads/writes prefer the Supabase API variables above when they are configured.
SUPABASE_DB_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
